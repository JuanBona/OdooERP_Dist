# Copiar a .env (NO commitear .env real) y completar con valores reales.
# Generar passwords fuertes, ej: openssl rand -base64 24

DB_NAME=odoo
DB_USER=odoo
DB_PASSWORD=CAMBIAR_ESTO

# Dominio real apuntando por DNS (registro A) a la IP del VPS.
DOMAIN=reparto.tudominio.com.ar

# Email para avisos de vencimiento de certificado (Let's Encrypt).
ACME_EMAIL=vos@tudominio.com

# Imágenes fijadas: un point-release nuevo de Odoo puede cambiar vistas/assets y
# romper módulos custom. Fijar por digest y actualizar a propósito (con backup).
# (digests al 2026-09-23; obtener el actual con `docker image inspect`)
ODOO_IMAGE=odoo@sha256:f99ffac95cb39a0924622ea4118481c95651d9c84187e5b30a21c2cc4419c7dd
POSTGRES_IMAGE=postgres@sha256:f1c3376c26f2609ab9f29f71f824103fe2fcd8ee0346485cb6122a4f93df6f94

# Backups (ver deploy/backup.sh). RCLONE_REMOTE = remoto `crypt` de rclone,
# HC_PING_URL = URL de check de healthchecks.io (alerta si el backup no corre).
RCLONE_REMOTE=
HC_PING_URL=
