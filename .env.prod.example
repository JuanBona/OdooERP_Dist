# Copiar a .env (NO commitear .env real) y completar con valores reales.
# Generar passwords fuertes, ej: openssl rand -base64 24

DB_NAME=odoo
DB_USER=odoo
DB_PASSWORD=CAMBIAR_ESTO

# Dominio real apuntando por DNS (registro A) a la IP del VPS.
DOMAIN=reparto.tudominio.com.ar

# Email para avisos de vencimiento de certificado (Let's Encrypt).
ACME_EMAIL=vos@tudominio.com
