<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="remito_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="doc_currency" t-value="o.company_id.currency_id"/>

                        <!-- Número de remito / fecha / hora -->
                        <div class="row mb-4">
                            <div class="col-12 text-right">
                                <h5>REMITO INTERNO</h5>
                                <div>
                                    <strong>Nº </strong>
                                    <t t-esc="o.remito_number"/>
                                </div>
                                <div>
                                    <strong>Fecha: </strong>
                                    <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                </div>
                                <div>
                                    <strong>Hora: </strong>
                                    <t t-esc="o.date_order.strftime('%H:%M') if o.date_order else ''"/>
                                </div>
                            </div>
                        </div>

                        <!-- Cliente / Vendedor -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h6>CLIENTE</h6>
                                <t t-if="o.partner_id">
                                    <div><t t-esc="o.partner_id.name"/></div>
                                    <t t-if="o.partner_id.vat">
                                        <div>CUIT/DNI: <t t-esc="o.partner_id.vat"/></div>
                                    </t>
                                    <t t-if="o.partner_id.street">
                                        <div>
                                            <t t-esc="o.partner_id.street"/>
                                            <t t-if="o.partner_id.city">
                                                <t t-esc="', ' + o.partner_id.city"/>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div>Consumidor Final</div>
                                </t>
                            </div>
                            <div class="col-6">
                                <h6>VENDEDOR</h6>
                                <div><t t-esc="o.user_id.name"/></div>
                                <div>Camión: <t t-esc="o.config_id.name"/></div>
                            </div>
                        </div>

                        <!-- Líneas de productos -->
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-right">Cant.</th>
                                    <th class="text-right">P. Unit.</th>
                                    <th class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.lines" t-as="line">
                                    <tr>
                                        <td><t t-esc="line.product_id.name"/></td>
                                        <td class="text-right" t-field="line.qty"/>
                                        <td class="text-right" t-field="line.price_unit"
                                            t-options='{"widget": "monetary", "display_currency": doc_currency}'/>
                                        <td class="text-right" t-field="line.price_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": doc_currency}'/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>TOTAL:</strong></td>
                                    <td class="text-right">
                                        <strong t-field="o.amount_total"
                                                t-options='{"widget": "monetary", "display_currency": doc_currency}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Condición de pago -->
                        <div class="mt-4">
                            <strong>Condición de pago: </strong>
                            <t t-if="o.payment_ids">
                                <t t-esc="o.payment_ids[0].payment_method_id.name"/>
                            </t>
                            <t t-else="">
                                <span>—</span>
                            </t>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
