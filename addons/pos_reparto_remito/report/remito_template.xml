<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="remito_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- Header: empresa + número de remito -->
                        <div class="row mb-4">
                            <div class="col-8">
                                <t t-if="o.company_id.logo">
                                    <img t-att-src="image_data_uri(o.company_id.logo)"
                                         style="max-height:60px; max-width:180px;" alt="Logo"/>
                                </t>
                                <h4 t-field="o.company_id.name"/>
                                <t t-if="o.company_id.vat">
                                    <span>CUIT: </span><span t-field="o.company_id.vat"/>
                                </t>
                                <div>
                                    <span t-field="o.company_id.street"/>
                                    <t t-if="o.company_id.city">
                                        <span> · </span><span t-field="o.company_id.city"/>
                                    </t>
                                </div>
                            </div>
                            <div class="col-4 text-right">
                                <h5>REMITO INTERNO</h5>
                                <div>
                                    <strong>Nº </strong>
                                    <span t-field="o.remito_number"/>
                                </div>
                                <div>
                                    <strong>Fecha: </strong>
                                    <span t-field="o.date_order" t-options='{"widget": "date"}'/>
                                </div>
                                <div>
                                    <strong>Hora: </strong>
                                    <span t-field="o.date_order" t-options='{"widget": "datetime", "format": "HH:mm"}'/>
                                </div>
                            </div>
                        </div>

                        <!-- Cliente / Vendedor -->
                        <div class="row mb-4">
                            <div class="col-6">
                                <h6>CLIENTE</h6>
                                <t t-if="o.partner_id">
                                    <div t-field="o.partner_id.name"/>
                                    <t t-if="o.partner_id.vat">
                                        <div>CUIT/DNI: <span t-field="o.partner_id.vat"/></div>
                                    </t>
                                    <t t-if="o.partner_id.street">
                                        <div>
                                            <span t-field="o.partner_id.street"/>
                                            <t t-if="o.partner_id.city">
                                                <span>, </span><span t-field="o.partner_id.city"/>
                                            </t>
                                        </div>
                                    </t>
                                </t>
                                <t t-else="">
                                    <div>Consumidor Final</div>
                                </t>
                            </div>
                            <div class="col-6">
                                <h6>VENDEDOR</h6>
                                <div t-field="o.user_id.name"/>
                                <div>Camión: <span t-field="o.config_id.name"/></div>
                            </div>
                        </div>

                        <!-- Líneas de productos -->
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-right">Cant.</th>
                                    <th class="text-right">P. Unit.</th>
                                    <th class="text-right">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.lines" t-as="line">
                                    <tr>
                                        <td t-field="line.product_id.name"/>
                                        <td class="text-right" t-field="line.qty"/>
                                        <td class="text-right" t-field="line.price_unit"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        <td class="text-right" t-field="line.price_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="3" class="text-right"><strong>TOTAL:</strong></td>
                                    <td class="text-right">
                                        <strong t-field="o.amount_total"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- Condición de pago -->
                        <div class="mt-4">
                            <strong>Condición de pago: </strong>
                            <t t-if="o.payment_ids">
                                <span t-field="o.payment_ids[0].payment_method_id.name"/>
                            </t>
                            <t t-else="">
                                <span>—</span>
                            </t>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
