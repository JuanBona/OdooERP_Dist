<odoo>
    <record id="view_reparto_ventas_vendedor_pivot" model="ir.ui.view">
        <field name="name">reparto.ventas.vendedor.pivot</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <pivot string="Ventas por vendedor">
                <field name="user_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="order_id" type="measure"/>
                <field name="product_qty" type="measure"/>
                <field name="price_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_reparto_ventas_vendedor_graph" model="ir.ui.view">
        <field name="name">reparto.ventas.vendedor.graph</field>
        <field name="model">report.pos.order</field>
        <field name="arch" type="xml">
            <graph string="Ventas por vendedor" type="bar">
                <field name="user_id"/>
                <field name="price_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_reparto_ventas_vendedor" model="ir.actions.act_window">
        <field name="name">Ventas por vendedor</field>
        <field name="res_model">report.pos.order</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="point_of_sale.view_report_pos_order_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
    </record>

    <record id="action_reparto_ventas_vendedor_pivot" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">pivot</field>
        <field name="view_id" ref="view_reparto_ventas_vendedor_pivot"/>
        <field name="act_window_id" ref="action_reparto_ventas_vendedor"/>
    </record>

    <record id="action_reparto_ventas_vendedor_graph" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_reparto_ventas_vendedor_graph"/>
        <field name="act_window_id" ref="action_reparto_ventas_vendedor"/>
    </record>

    <menuitem id="menu_reparto_ventas_vendedor"
        name="Ventas por vendedor"
        parent="point_of_sale.menu_point_root"
        action="action_reparto_ventas_vendedor"
        groups="pos_reparto_security.group_reparto_adminop,pos_reparto_security.group_reparto_gerencia"
        sequence="17"/>
</odoo>
