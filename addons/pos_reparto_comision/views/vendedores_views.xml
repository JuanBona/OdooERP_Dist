<odoo>
    <!--
      Menu "Vendedores" (Gerencia): lista corta de vendedores y externos para cargar el % de comision y
      la marca de externo. Es la unica forma en que Gerencia edita un usuario (ver res_users.py), asi que
      el nombre, el usuario y el camion se muestran de solo lectura.
    -->
    <record id="view_users_list_reparto_vendedores" model="ir.ui.view">
        <field name="name">res.users.list.reparto.vendedores</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Vendedores" create="0" delete="0" import="0" export_xlsx="0">
                <field name="name"/>
                <field name="login"/>
                <field name="reparto_camion_asignado_id"/>
                <field name="reparto_comision_pct" invisible="reparto_es_externo"/>
                <field name="reparto_es_externo"/>
            </list>
        </field>
    </record>

    <record id="view_users_form_reparto_vendedores" model="ir.ui.view">
        <field name="name">res.users.form.reparto.vendedores</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Vendedor" create="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="login" readonly="1"/>
                            <field name="reparto_camion_asignado_id" readonly="1"/>
                        </group>
                        <group string="Comisión">
                            <field name="reparto_comision_pct" invisible="reparto_es_externo"/>
                            <field name="reparto_es_externo"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reparto_vendedores" model="ir.actions.act_window">
        <field name="name">Vendedores</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="['|', ('group_ids', 'in', [ref('pos_reparto_security.group_reparto_vendedor')]), ('reparto_es_externo', '=', True)]"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_users_list_reparto_vendedores')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_users_form_reparto_vendedores')})]"/>
    </record>

    <menuitem id="menu_reparto_vendedores"
              name="Vendedores"
              parent="point_of_sale.menu_point_root"
              action="action_reparto_vendedores"
              sequence="52"
              groups="pos_reparto_security.group_reparto_gerencia"/>
</odoo>
